@article{VRG:bhaskaran-nair:2014:JCP,
  title = {Equation of Motion Coupled Cluster Methods for Electron Attachment and Ionization Potential in Fullerenes {{C60}} and {{C70}}},
  author = {{Bhaskaran-Nair}, Kiran and Kowalski, Karol and Moreno, Juana and Jarrell, Mark and Shelton, William A},
  year = {2014},
