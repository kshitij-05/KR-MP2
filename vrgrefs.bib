@article{VRG:qiang:2018:NP,
  title = {Large-Scale Silicon Quantum Photonics Implementing Arbitrary Two-Qubit Processing},
  author = {Qiang, Xiaogang and Zhou, Xiaoqi and Wang, Jianwei and Wilkes, Callum M and Loke, Thomas and O'Gara, Sean and Kling, Laurent and Marshall, Graham D and Santagati, Raffaele and Ralph, Timothy C and Wang, Jingbo B and O'Brien, Jeremy L and Thompson, Mark G and Matthews, Jonathan C F},
  year = {2018},
