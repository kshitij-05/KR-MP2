@article{VRG:booth:2012:JCP,
  title = {Communication: {{Excited}} States, Dynamic Correlation Functions and Spectral Properties from Full Configuration Interaction Quantum {{Monte Carlo}}.},
  author = {Booth, George H and Chan, Garnet Kin-Lic},
  year = {2012},
  month = nov,
  journal = {J. Chem. Phys.},
