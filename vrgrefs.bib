@article{VRG:matthews:2015:JCP,
  title = {Non-Orthogonal Spin-Adaptation of Coupled Cluster Methods: {{A}} New Implementation of Methods Including Quadruple Excitations},
  author = {Matthews, Devin A and Stanton, John F},
  year = {2015},
  month = feb,
  journal = {J. Chem. Phys.},
  volume = {142},
  number = {6},
