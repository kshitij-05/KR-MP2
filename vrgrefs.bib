@article{VRG:kelly:2014:JCP,
  title = {Monte {{Carlo}} Configuration Interaction with Perturbation Corrections for Dissociation Energies of First Row Diatomic Molecules: {{C2}}, {{N2}}, {{O2}}, {{CO}}, and {{NO}}},
  author = {Kelly, Thomas P and Perera, Ajith and Bartlett, Rodney J and Greer, James C},
  year = {2014},
  month = feb,
  journal = {J. Chem. Phys.},
  volume = {140},
  number = {8},
  pages = {084114},
  publisher = {AIP Publishing},
  doi = {10.1063/1.4866609},
  url = {http://scitation.aip.org/content/aip/journal/jcp/140/8/10.1063/1.4866609},
  abstract = {Dissociation energies for the diatomic molecules C2, N2, O2, CO, and NO are estimated using the Monte Carlo configuration interaction (MCCI) and augmented by a second order perturbation theory correction. The calculations are performed using the correlation consistent polarized valence ``triple zeta'' atomic orbital basis and resulting dissociation energies are compared to coupled cluster calculations including up to triple excitations (CCSDT) and Full Configuration Interaction Quantum Monte Carlo (FCIQMC) estimates. It is found that the MCCI method readily describes the correct behavior for dissociation for the diatomics even when capturing only a relatively small fraction ({$\sim$}80\%) of the correlation energy. At this level only a small number of configurations, typically O(103) from a FCI space of dimension O(1014), are required to describe dissociation. Including the perturbation correction to the MCCI estimates, the difference in dissociation energies with respect to CCSDT ranges between 1.2 and 3.1 kcal/mol, and the difference when comparing to FCIQMC estimates narrows to between 0.5 and 1.9 kcal/mol. Discussions on MCCI\&apos;s ability to recover static and dynamic correlations and on the form of correlations in the electronic configuration space are presented.},
  date-added = {2014-03-03T17:51:01GMT},
  date-modified = {2019-12-29T22:17:18GMT},
  langid = {english},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2014/Kelly/J\%20Chem\%20Phys\%202014\%20Kelly.pdf},
  rating = {0},
  read = {Yes},
  uri = {papers2://publication/doi/10.1063/1.4866609},
