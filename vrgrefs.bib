@phdthesis{VRG:justinthomasfermann:1996:,
  title = {Efficient {{Implementation}} of {{Vertical Recursion Relations}} for the {{Generation}} of {{Electron Repulsion Integrals}}},
  author = {{Justin Thomas Fermann}},
  year = {1996},
  address = {Athens, GA, USA},
  abstract = {The evaluation of four-center electron repulsion integrals for a specified basis set is the first and, with the integral derivatives, frequently the most expensive step in ab initio applications. Since 1985, many of the advances made towards enhancing their computational affordability have employed several recursion relations that have no unique implementation; rather, choosing the order in which to apply them and optimizing the layout of intermediate quantities constitutes a non-trivial tree search problem. This is the sort of problem best resolved by a computer program. For this work, several programs have been written that apply the Head-Gordon and Pople vertical recursion relations to the class of integral specified as input, making an internal representation of the tree search problem. A path through the tree is chosen based on the potential to employ specially optimized, machine gener\- ated, subroutines. This path is translated into the sequence of elementary algebraic steps that it represents, and then emitted in a high level programming language. The file thus produced can be compiled as a highly optimized component of an integral program which is consequently more efficient. The routines produced by this program have been incorporated into a stand\- alone integrals program and a direct SCF program. The effectiveness of the opti\- mizations performed are verified by comparisons with hand optimized integral pack\- ages through their application to several standard test molecules.},
  langid = {english},
  school = {University of Georgia},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/4JQWJDN5/Justin Thomas Fermann - 1996 - Efficient Implementation of Vertical Recursion Rel.pdf}
}

