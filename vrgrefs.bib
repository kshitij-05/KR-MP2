@article{VRG:helgaker:1991:JCP,
  title = {An Electronic {{Hamiltonian}} for Origin Independent Calculations of Magnetic Properties},
  author = {Helgaker, Trygve and Jo̸rgensen, Poul},
  year = {1991},
  journal = {J. Chem. Phys.},
  volume = {95},
  number = {4},
  pages = {2595--2601},
  publisher = {AIP Publishing},
  doi = {10.1063/1.460912},
  url = {http://scitation.aip.org/content/aip/journal/jcp/95/4/10.1063/1.460912},
  abstract = {A gauge origin independent formalism for the calculation of molecular magnetic properties is presented. Origin independence is obtained by using London's gauge invariant atomic orbitals, expanding the second quantization Hamiltonian in the external magnetic field and nuclear magnetic moments, and using the resulting expansion terms as perturbation operators in response function calculations. To ensure orthonormality of the molecular orbitals, a field-dependent symmetrical orthonormalization is employed. In this way the gauge dependence of the London orbitals is transferred to the Hamiltonian. The resulting perturbation operators may be used to calculate magnetic properties from any approximate a b i n i t i owave function.},
  date-added = {2015-10-06T12:30:49GMT},
  date-modified = {2019-12-29T22:17:18GMT},
  langid = {english},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/1991/Helgaker/J\%20Chem\%20Phys\%201991\%20Helgaker.pdf},
