@article{VRG:zajac:2018:S,
  title = {Resonantly Driven {{CNOT}} Gate for Electron Spins},
  author = {Zajac, D M and Sigillito, A J and Russ, M and Borjans, F and Taylor, J M and Burkard, G and Petta, J R},
  year = {2018},
  month = jan,
  journal = {Science},
  volume = {359},
  number = {6374},
  pages = {439--442},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/science.aao5965},
  url = {https://science.sciencemag.org/content/359/6374/439.abstract},
  abstract = {To build a universal quantum computer---the kind that can handle any computational task you throw at it---an essential early step is to demonstrate the so-called CNOT gate, which acts on two qubits. Zajac et al. built an efficient CNOT gate by using electron spin qubits in silicon quantum dots, an implementation that is especially appealing because of its compatibility with existing semiconductor-based electronics (see the Perspective by Schreiber and Bluhm). To showcase the potential, the authors used the gate to create an entangled quantum state called the Bell state. Science , this issue p. [439][1]; see also p. [393][2] Single-qubit rotations and two-qubit CNOT operations are crucial ingredients for universal quantum computing. Although high-fidelity single-qubit operations have been achieved using the electron spin degree of freedom, realizing a robust CNOT gate has been challenging because of rapid nuclear spin dephasing and charge noise. We demonstrate an efficient resonantly driven CNOT gate for electron spins in silicon. Our platform achieves single-qubit rotations with fidelities greater than 99\%, as verified by randomized benchmarking. Gate control of the exchange coupling allows a quantum CNOT gate to be implemented with resonant driving in  200 nanoseconds. We used the CNOT gate to generate a Bell state with 78\% fidelity (corrected for errors in state preparation and measurement). Our quantum dot device architecture enables multi-qubit algorithms in silicon. [1]: /lookup/volpage/359/439?iss=6374 [2]: /lookup/doi/10.1126/science.aar6209},
  date-added = {2019-04-30T20:50:27GMT},
  date-modified = {2019-12-29T22:17:19GMT},
  langid = {english},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2018/Zajac/Science\%202018\%20Zajac.pdf},
  pmid = {29217586},
  rating = {0},
  uri = {papers2://publication/doi/10.1126/science.aao5965},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/58C4NAUY/Science 2018 Zajac.pdf}
}

