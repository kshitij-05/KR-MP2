@article{VRG:benedict:1940:JCP,
  title = {An Empirical Equation for Thermodynamic Properties of Light Hydrocarbons and Their Mixtures i. {{Methane}}, Ethane, Propane and n-{{Butane}}},
  author = {Benedict, Manson and Webb, George B and Rubin, Louis C},
  year = {1940},
