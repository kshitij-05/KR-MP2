@article{VRG:kong:2011:JCP,
  title = {A Novel Interpretation of Reduced Density Matrix and Cumulant for Electronic Structure Theories.},
  author = {Kong, Liguo and Valeev, Edward F},
  year = {2011},
  month = jun,
  journal = {J. Chem. Phys.},
  volume = {134},
  number = {21},
  pages = {214109},
  doi = {10.1063/1.3596948},
  url = {http://eutils.ncbi.nlm.nih.gov/entrez/eutils/elink.fcgi?dbfrom=pubmed&id=21663346&retmode=ref&cmd=prlinks},
  abstract = {We propose a novel interpretation of the reduced density matrix (RDM) and its cumulant that combines linear and exponential parametrizations of the wavefunction. Any n-particle RDM can be written as a weighted average of "configuration interaction" amplitudes. The corresponding n-particle cumulant is represented in terms of two types of contributions: "connected" (statistical averages of substitution amplitudes) and "disconnected" (cross-correlations of substitution amplitudes). A diagonal element of n-RDM represents the average occupation number of the orbital n-tuple. The diagonal elements of 2- and 3-cumulants take particularly elegant forms in the natural spin-orbital basis: they represent the covariances (correlated fluctuations) of the occupation numbers of the orbital pair and triples, respectively. Thus, the diagonal elements of the cumulants quantify the correlation between the orbital occupation numbers. Our interpretation is used to examine the weak to strong correlation transition in the "two electrons in two orbitals" problem.},
  affiliation = {Department of Chemistry, Virginia Tech, Blacksburg, Virginia 24061, USA. liguokong@gmail.com},
  date-added = {2012-08-28T17:02:26GMT},
  date-modified = {2019-12-29T22:17:18GMT},
  langid = {english},
  pmid = {21663346},
  rating = {0},
  uri = {papers2://publication/doi/10.1063/1.3596948},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/J7TLPX6A/Kong and Valeev - 2011 - A novel interpretation of reduced density matrix a.pdf}
}

@article{VRG:kong:2011:JCPa,
  title = {{{SF-}}[2]{{R12}}: {{A}} Spin-Adapted Explicitly Correlated Method Applicable to Arbitrary Electronic States},
  author = {Kong, Liguo and Valeev, Edward F},
  year = {2011},
  month = dec,
  journal = {J. Chem. Phys.},
  volume = {135},
  number = {21},
  pages = {214105},
  publisher = {AIP Publishing},
  doi = {10.1063/1.3664729},
  url = {http://scitation.aip.org.ezproxy.lib.vt.edu:8080/content/aip/journal/jcp/135/21/10.1063/1.3664729},
  abstract = {The [ 2 ] R12 method [M. Torheyden and E. F. Valeev, J. Chem. Phys.131, 171103 (2009)10.1063/1.3254836] is an explicitly correlated perturbative correction that can greatly reduce the basis set error of an arbitrary electronic structure method for which the two-electron density matrix is available. Here we present a spin-adapted variant (denoted as SF-[2] R12 ) that is formulated completely in terms of spin-free quantities. A spin-free cumulant decomposition and multi-reference generalized Brillouin condition are used to avoid three-particle reduced density matrix completely. The computational complexity of SF-[2] R12 is proportional to the sixth power of the system size and is comparable to the cost of the single-reference MP2-R12 method. The SF-[2] R12 method is shown to decrease greatly the basis set error of multi-configurational wave functions.},
  date-added = {2013-12-16T17:46:50GMT},
  date-modified = {2020-04-24T20:11:41GMT},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2011/Kong/J\%20Chem\%20Phys\%202011\%20Kong.pdf},
