@inproceedings{VRG:bosilca:2020:2I5IWESPMME,
  title = {The {{Template Task Graph}} ({{TTG}}) - an Emerging Practical Dataflow Programming Paradigm for Scientific Simulation at Extreme Scale},
  booktitle = {2020 {{IEEEACM}} 5th {{Int}}. {{Workshop Extreme Scale Program}}. {{Models Middlew}}. {{ESPM2}}},
  author = {Bosilca, G. and Harrison, R. J. and Herault, T. and Javanmard, M. M. and Nookala, P. and Valeev, E. F.},
  year = {2020},
  month = nov,
  pages = {1--7},
  doi = {10.1109/ESPM251964.2020.00011},
  url = {https://ieeexplore.ieee.org/document/9307054},
  abstract = {We describe TESSE, an emerging general-purpose, open-source software ecosystem that attacks the twin challenges of programmer productivity and portable performance for advanced scientific applications on modern high-performance computers. TESSE builds upon and extends the ParsecDAG/-dataflow runtime with a new Domain Specific Languages (DSL) and new integration capabilities. Motivating this work is our belief that such a dataflow model, perhaps with applications composed in domain specific languages, can overcome many of the challenges faced by a wide variety of irregular applications that are poorly served by current programming and execution models. Two such applications from many-body physics and applied mathematics are briefly explored. This paper focuses upon the Template Task Graph (TTG), which is TESSE's main C++ Api that provides a powerful work/data-flow programming model. Algorithms on spatial trees, block-sparse tensors, and wave fronts are used to illustrate the API and associated concepts, as well as to compare with related approaches.},
  isbn = {978-0-7381-1074-5},
  langid = {english},
  keywords = {Algebra,C++ languages,Computational modeling,DAG,dataflow,exascale,graph,high-performance computing,Programming,Runtime,Task analysis,Tensors,workflow},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/99S6DNTR/Bosilca et al. - 2020 - The Template Task Graph (TTG) - an emerging practi.pdf}
}

@article{VRG:bosko:2023:JCP,
  title = {Derivation and Reinterpretation of the {{Fermi}}--{{Amaldi}} Functional},
  author = {Bosko, Ivan P. and Staroverov, Viktor N.},
  year = {2023},
  month = oct,
  journal = {J. Chem. Phys.},
  volume = {159},
  number = {13},
  pages = {131101},
  issn = {0021-9606, 1089-7690},
  doi = {10.1063/5.0166358},
  url = {https://pubs.aip.org/jcp/article/159/13/131101/2915129/Derivation-and-reinterpretation-of-the-Fermi},
  urldate = {2024-07-30},
  abstract = {The Fermi--Amaldi correction to the electrostatic self-repulsion of the particle density is usually regarded as a semi-classical exchange functional that happens to be exact only for one- and closed-shell two-electron systems. We show that this functional can be derived quantum-mechanically and is exact for any number of fermions or bosons of arbitrary spin as long as the particles occupy the same spatial orbital. The Fermi--Amaldi functional is also size-consistent for such systems, provided that the factor N in its expression is understood as an orbital occupation number rather than the total number of particles. These properties of the Fermi--Amaldi functional are ultimately related to the fact that it is a special case of the self-exchange energy formula. Implications of our findings are discussed.},
  langid = {english},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/PF6GG2QV/Bosko and Staroverov - 2023 - Derivation and reinterpretation of the Fermi–Amald.pdf}
}

