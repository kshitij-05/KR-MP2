@article{VRG:smith:2017:SR,
  title = {Ab Initio Calculation of Energy Levels for Phosphorus Donors in Silicon},
  author = {Smith, J S and Budi, A and Per, M C and Vogt, N and Drumm, D W and Hollenberg, L C L and Cole, J H and Russo, S P},
