@article{VRG:znojil:2017:S,
  title = {Schr{\"o}dinger Equations with Logarithmic Self-Interactions: {{From}} Antilinear {{PT-Symmetry}} to the Nonlinear Coupling of Channels},
  author = {Znojil, Miloslav and R{\r u}{\v z}i{\v c}ka, Franti{\v s}ek and Zloshchastiev, Konstantin},
  year = {2017},
  month = aug,
  journal = {Symmetry},
  volume = {9},
  number = {8},
  pages = {165},
  publisher = {Multidisciplinary Digital Publishing Institute},
  doi = {10.3934/dcds.2010.27.1283},
  url = {http://www.mdpi.com/2073-8994/9/8/165},
  abstract = {Schr{\"o}dinger equations with non-Hermitian, but PT -symmetric quantum potentials V ( x ) found, recently, a new field of applicability in classical optics. The potential acquired there a new physical role of an ``anomalous'' refraction index. This turned attention to the nonlinear Schr{\"o}dinger equations in which the interaction term becomes state-dependent, V ( x ) {$\rightarrow$} W ( {$\psi$} ( x ) , x ) . Here, the state-dependence in W ( {$\psi$} ( x ) , x ) is assumed logarithmic, and some of the necessary mathematical assumptions, as well as some of the potential phenomenological consequences of this choice are described. Firstly, an elementary single-channel version of the nonlinear logarithmic model is outlined in which the complex self-interaction W ( {$\psi$} ( x ) , x ) is regularized via a deformation of the real line of x into a self-consistently constructed complex contour C. The new role played by PT -symmetry is revealed. Secondly, the regularization is sought for a multiplet of equations, coupled via the same nonlinear self-interaction coupling of channels. The resulting mathematical structures are shown to extend the existing range of physics covered by the logarithmic Schr{\"o}dinger equations.},
  date-added = {2018-09-21T19:11:50GMT},
  date-modified = {2019-12-29T22:18:01GMT},
  langid = {english},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2017/Znojil/Symmetry\%202017\%20Znojil.pdf},
  rating = {0},
  read = {Yes},
  uri = {papers2://publication/doi/10.3934/dcds.2010.27.1283},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/3H6U2C8I/Symmetry 2017 Znojil.pdf}
}

