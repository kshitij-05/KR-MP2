  pmid = {16189584},
  rating = {0},
  read = {Yes},
  uri = {papers2://publication/doi/10.1039/b507781h},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/LR3VMQCP/Phys Chem Chem Phys 2005 May.pdf}
}

