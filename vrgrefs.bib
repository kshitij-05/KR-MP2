@article{VRG:yang:2011:JCP,
  title = {Tensor Factorizations of Local Second-Order {{M{\o}ller}}--{{Plesset}} Theory},
  author = {Yang, Jun and Kurashige, Yuki and Manby, Frederick R and Chan, Garnet K L},
  year = {2011},
  month = jan,
  journal = {J. Chem. Phys.},
  volume = {134},
  number = {4},
  pages = {044123},
  publisher = {AIP Publishing},
  doi = {10.1063/1.3528935},
  url = {http://scitation.aip.org.ezproxy.lib.vt.edu:8080/content/aip/journal/jcp/134/4/10.1063/1.3528935},
  abstract = {Efficient electronic structure methods can be built around efficient tensor representations of the wavefunction. Here we first describe a general view of tensor factorization for the compact representation of electronic wavefunctions. Next, we use this language to construct a low-complexity representation of the doubles amplitudes in local second-order M{\o}ller--Plesset perturbation theory. We introduce two approximations---the direct orbital-specific virtual approximation and the full orbital-specific virtual approximation. In these approximations, each occupied orbital is associated with a small set of correlating virtual orbitals. Conceptually, the representation lies between the projected atomic orbital representation in Pulay--Saeb{\o} local correlation theories and pair natural orbital correlation theories. We have tested the orbital-specific virtual approximations on a variety of systems and properties including total energies, reaction energies, and potential energy curves. Compared to the Pulay--Saeb{\o} ansatz, we find that these approximations exhibit favorable accuracy and computational times while yielding smooth potential energy curves.},
  date-added = {2014-06-04T15:32:22GMT},
  date-modified = {2019-12-29T22:17:19GMT},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2011/Yang/J\%20Chem\%20Phys\%202011\%20Yang.pdf},
  rating = {0},
  read = {Yes},
  uri = {papers2://publication/doi/10.1063/1.3528935},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/RRR2W5M7/J Chem Phys 2011 Yang.pdf}
}

