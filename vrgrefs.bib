@article{VRG:hobson:2013:AJP,
  title = {There Are No Particles, There Are Only Fields},
  author = {Hobson, Art},
  year = {2013},
  month = feb,
  journal = {Am. J. Phys.},
  volume = {81},
  number = {3},
  pages = {211--223},
  publisher = {American Association of Physics Teachers},
  doi = {10.1119/1.4789885},
  url = {http://scitation.aip.org.ezproxy.lib.vt.edu:8080/content/aapt/journal/ajp/81/3/10.1119/1.4789885},
  abstract = {Quantum foundations are still unsettled, with mixed effects on science and society. By now it should be possible to obtain consensus on at least one issue: Are the fundamental constituents fields or particles? As this paper shows, experiment and theory imply that unbounded fields, not bounded particles, are fundamental. This is especially clear for relativistic systems, implying that it\&apos;s also true of nonrelativistic systems. Particles are epiphenomena arising from fields. Thus, the Schr{\"o}dinger field is a space-filling physical field whose value at any spatial point is the probability amplitude for an interaction to occur at that point. The field for an electron is the electron; each electron extends over both slits in the two-slit experiment and spreads over the entire pattern; and quantum physics is about interactions of microscopic systems with the macroscopic world rather than just about measurements. It\&apos;s important to clarify this issue because textbooks still teach a particles- and measurement-oriented interpretation that contributes to bewilderment among students and pseudoscience among the public. This article reviews classical and quantum fields, the two-slit experiment, rigorous theorems showing particles are inconsistent with relativistic quantum theory, and several phenomena showing particles are incompatible with quantum field theories.},
  date-added = {2014-04-22T18:43:19GMT},
  date-modified = {2019-12-29T22:17:18GMT},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2013/Hobson/American\%20Journal\%20of\%20Physics\%202013\%20Hobson.pdf},
  rating = {0},
  read = {Yes},
  uri = {papers2://publication/doi/10.1119/1.4789885},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/L79QNISW/American Journal of Physics 2013 Hobson.pdf}
}

