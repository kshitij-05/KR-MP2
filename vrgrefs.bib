@article{VRG:loos:2013:JCP,
  title = {Uniform Electron Gases. {{I}}. {{Electrons}} on a Ring},
  author = {Loos, Pierre-Fran{\c c}ois and Gill, Peter M W},
  year = {2013},
  month = apr,
  journal = {J. Chem. Phys.},
  volume = {138},
  number = {16},
  pages = {164124},
  publisher = {AIP Publishing},
  doi = {10.1063/1.4802589},
  url = {http://scitation.aip.org.ezproxy.lib.vt.edu:8080/content/aip/journal/jcp/138/16/10.1063/1.4802589},
  abstract = {We introduce a new paradigm for one-dimensional uniform electron gases (UEGs). In this model, n electrons are confined to a ring and interact via a bare Coulomb operator. We use Rayleigh-Schr{\"o}dinger perturbation theory to show that, in the high-density regime, the ground-state reduced (i.e., per electron) energy can be expanded as {$\varepsilon$} ( r s , n ) = {$\varepsilon$} 0 ( n ) r s - 2 + {$\varepsilon$} 1 ( n ) r s - 1 + {$\varepsilon$} 2 ( n ) + {$\varepsilon$} 3 ( n ) r s + {$\cdots$} , where r s is the Seitz radius. We use strong-coupling perturbation theory and show that, in the low-density regime, the reduced energy can be expanded as {$\varepsilon$} ( r s , n ) = {$\eta$} 0 ( n ) r s - 1 + {$\eta$} 1 ( n ) r s - 3 / 2 + {$\eta$} 2 ( n ) r s - 2 + {$\cdots$} . We report explicit expressions for {$\varepsilon$}0(n), {$\varepsilon$}1(n), {$\varepsilon$}2(n), {$\varepsilon$}3(n), {$\eta$}0(n), and {$\eta$}1(n) and derive the thermodynamic (large-n) limits of each of these. Finally, we perform numerical studies of UEGs with n = 2, 3, {\dots}, 10, using Hylleraas-type and quantum Monte Carlo methods, and combine these with the perturbative results to obtain a picture of the behavior of the new model over the full range of n and r s values.},
  date-added = {2014-04-23T16:06:17GMT},
  date-modified = {2019-12-29T22:17:18GMT},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2013/Loos/J\%20Chem\%20Phys\%202013\%20Loos.pdf},
  rating = {0},
  uri = {papers2://publication/doi/10.1063/1.4802589},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/WR84DFCH/J Chem Phys 2013 Loos.pdf}
}

