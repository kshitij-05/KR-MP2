@article{VRG:luo:2002:JCP,
  title = {Wavelet Approximation of Correlated Wave Functions. {{II}}. {{Hyperbolic}} Wavelets and Adaptive Approximation Schemes},
  author = {Luo, Hongjun and Kolb, Dietmar and Flad, Heinz-J{\"u}rgen and Hackbusch, Wolfgang and Koprucki, Thomas},
  year = {2002},
  journal = {J. Chem. Phys.},
  volume = {117},
  number = {8},
  pages = {3625--3638},
  publisher = {AIP Publishing},
  doi = {10.1063/1.1494800},
  url = {http://scitation.aip.org/content/aip/journal/jcp/117/8/10.1063/1.1494800},
  abstract = {We have studied various aspects concerning the use of hyperbolic wavelets and adaptive approximation schemes for wavelet expansions of correlated wave functions. In order to analyze the consequences of reduced regularity of the wave function at the electron--electron cusp, we first considered a realistic exactly solvable many-particle model in one dimension. Convergence rates of wavelet expansions, with respect to L 2 and H 1 norms and the energy, were established for this model. We compare the performance of hyperbolic wavelets and their extensions through adaptive refinement in the cusp region, to a fully adaptive treatment based on the energy contribution of individual wavelets. Although hyperbolic wavelets show an inferior convergence behavior, they can be easily refined in the cusp region yielding an optimal convergence rate for the energy. Preliminary results for the helium atom are presented, which demonstrate the transferability of our observations to more realistic systems. We propose a contraction scheme for wavelets in the cusp region, which reduces the number of degrees of freedom and yields a favorable cost to benefit ratio for the evaluation of matrix elements.},
  date-added = {2014-04-28T13:37:34GMT},
  date-modified = {2019-12-29T22:17:18GMT},
  langid = {english},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2002/Luo/J\%20Chem\%20Phys\%202002\%20Luo.pdf},
  rating = {0},
  read = {Yes},
  uri = {papers2://publication/doi/10.1063/1.1494800},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/9XMP7E7Q/J Chem Phys 2002 Luo.pdf}
}

