@article{VRG:weber:2018:NQI,
  title = {Spin--Orbit Coupling in Silicon for Electrons Bound to Donors},
  author = {Weber, Bent and Hsueh, Yu-Ling and Watson, Thomas F and Li, Ruoyu and Hamilton, Alexander R and Hollenberg, Lloyd C L and Rahman, Rajib and Simmons, Michelle Y},
  year = {2018},
  month = nov,
  journal = {Npj Quantum Inf.},
  volume = {4},
  number = {1},
  pages = {120},
  publisher = {Nature Publishing Group},
  doi = {10.1103/PhysRevB.94.081412},
  url = {http://www.nature.com/articles/s41534-018-0111-1},
  abstract = {Spin--orbit coupling (SOC) is fundamental to a wide range of phenomena in condensed matter, spanning from a renormalisation of the free-electron g-factor, to the formation of topological insulators, and Majorana Fermions. SOC has also profound implications in spin-based quantum information, where it is known to limit spin lifetimes (T1) in the inversion asymmetric semiconductors such as GaAs. However, for electrons in silicon---and in particular those bound to phosphorus donor qubits---SOC is usually regarded weak, allowing for spin lifetimes of minutes in the bulk. Surprisingly, however, in a nanoelectronic device donor spin lifetimes have only reached values of seconds. Here, we reconcile this difference by demonstrating that electric field induced SOC can dominate spin relaxation of donor-bound electrons. Eliminating this lifetime-limiting effect by careful alignment of an external vector magnetic field in an atomically engineered device, allows us to reach the bulk-limit of spin-relaxation times. Given the unexpected strength of SOC in the technologically relevant silicon platform, we anticipate that our results will stimulate future theoretical and experimental investigation of phenomena that rely on strong magnetoelectric coupling of atomically confined spins.},
  date-added = {2019-05-03T17:13:01GMT},
  date-modified = {2019-12-29T22:17:19GMT},
  langid = {english},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2018/Weber/npj\%20Quantum\%20Inf\%202018\%20Weber.pdf},
  rating = {0},
  uri = {papers2://publication/doi/10.1103/PhysRevB.94.081412},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/4A4FK3MK/npj Quantum Inf 2018 Weber.pdf}
}

