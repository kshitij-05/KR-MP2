@article{VRG:awschalom:2018:NP,
  title = {Quantum Technologies with Optically Interfaced Solid-State Spins},
  author = {Awschalom, David D and Hanson, Ronald and Wrachtrup, J{\"o}rg and Zhou, Brian B},
