@article{VRG:hermann:2020:NC,
  title = {Deep-Neural-Network Solution of the Electronic {{Schr{\"o}dinger}} Equation},
  author = {Hermann, Jan and Sch{\"a}tzle, Zeno and No{\'e}, Frank},
  year = {2020},
  month = sep,
  journal = {Nat. Chem.},
  volume = {12},
  number = {10},
  pages = {891--897},
  publisher = {Nature Publishing Group},
  doi = {10.1038/s41557-020-0544-y},
  url = {https://www.nature.com/articles/s41557-020-0544-y},
  abstract = {The electronic Schr{\"o}dinger equation can only be solved analytically for the hydrogen atom, and the numerically exact full configuration-interaction method is exponentially expensive in the number of electrons. Quantum Monte Carlo methods are a possible way out: they scale well for large molecules, they can be parallelized and their accuracy has, as yet, been only limited by the flexibility of the wavefunction ansatz used. Here we propose PauliNet, a deep-learning wavefunction ansatz that achieves nearly exact solutions of the electronic Schr{\"o}dinger equation for molecules with up to 30 electrons. PauliNet has a multireference Hartree--Fock solution built in as a baseline, incorporates the physics of valid wavefunctions and is trained using variational quantum Monte Carlo. PauliNet outperforms previous state-of-the-art variational ansatzes for atoms, diatomic molecules and a strongly correlated linear H10, and matches the accuracy of highly specialized quantum chemistry methods on the transition-state energy of cyclobutadiene, while being computationally efficient. High-accuracy quantum chemistry methods struggle with a combinatorial explosion of Slater determinants in larger molecular systems, but now a method has been developed that learns electronic wavefunctions with deep neural networks and reaches high accuracy with only a few determinants. The method is applicable to realistic chemical processes such as the automerization of cyclobutadiene.},
  date-added = {2020-12-23T16:13:38GMT},
  date-modified = {2021-01-19T13:53:30GMT},
  langid = {english},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2020/Hermann/Nature\%20Chem\%202020\%20Hermann.pdf},
  rating = {0},
  uri = {papers2://publication/doi/10.1038/s41557-020-0544-y},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/29VYGM6U/Nature Chem 2020 Hermann.pdf}
}

