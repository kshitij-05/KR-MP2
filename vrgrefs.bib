  title = {{{PSI4}} 1.4: {{Open-source}} Software for High-Throughput Quantum Chemistry},
  author = {Smith, Daniel G A and Burns, Lori A and Simmonett, Andrew C and Parrish, Robert M and Schieber, Matthew C and Galvelis, Raimondas and Kraus, Peter and Kruse, Holger and Di Remigio, Roberto and Alenaizan, Asem and James, Andrew M and Lehtola, Susi and Misiewicz, Jonathon P and Scheurer, Maximilian and Shaw, Robert A and Schriber, Jeffrey B and Xie, Yi and Glick, Zachary L and Sirianni, Dominic A and O'Brien, Joseph Senan and Waldrop, Jonathan M and Kumar, Ashutosh and Hohenstein, Edward G and Pritchard, Benjamin P and Brooks, Bernard R and SchaeferIII, Henry F and Sokolov, Alexander Yu and Patkowski, Konrad and DePrinceIII, A Eugene and Bozkaya, U{\u g}ur and King, Rollin A and Evangelista, Francesco A and Turney, Justin M and Crawford, T Daniel and Sherrill, C David},
