@article{VRG:fedorov:2007:JPCA,
  title = {Extending the Power of Quantum Chemistry to Large Systems with the Fragment Molecular Orbital Method},
  author = {Fedorov, Dmitri G and Kitaura, Kazuo},
  year = {2007},
