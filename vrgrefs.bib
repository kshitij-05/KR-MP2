  url = {https://www.mdpi.com/2218-1997/7/5/124},
  urldate = {2023-04-28},
  abstract = {We have developed a quantum field theory of spinors based on the algebra of canonical anticommutation relations (CAR algebra) of Grassmann densities in the momentum space. We have proven the existence of two spinor vacua. Operators C and T transform the normal vacuum into an alternative one, which leads to the breaking of the C and T symmetries. The CPT is the real structure operator; it preserves the normal vacuum. We have proven that, in the theory of the Dirac Sea, the formula for the charge conjugation operator must contain an additional generalized Dirac conjugation operator.},
  langid = {english},
  keywords = {Dirac equation},
  file = {/Users/efv/odrive/gdrive-w/Work/Zotero/storage/AIWHQEZN/Monakhov - 2021 - The Dirac Sea, T and C Symmetry Breaking, and the .pdf}
}

