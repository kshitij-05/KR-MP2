@article{VRG:noga:2005:MP,
  title = {Improved Algorithm for Triple-Excitation Contributions within the Coupled Cluster Approach},
  author = {Noga, Jozef and Valiron, Pierre},
  year = {2005},
  month = aug,
  journal = {Mol. Phys.},
  volume = {103},
  number = {15-16},
  pages = {2123--2130},
  publisher = {Taylor \& Francis Group},
  doi = {10.1080/00268970500131140},
  url = {http://www.tandfonline.com/doi/abs/10.1080/00268970500131140},
  abstract = {A new algorithm to handle triple-excitation contributions within the coupled cluster and/or many body perturbation theory is presented. It achieves a theoretical acceleration factor of 3 on a sub-set of the calculations, resulting for molecules in C1 symmetry in a maximal speedup of 1.6 and 2.0 for open and closed shell cases, respectively. The algorithm is based on common footing for ppph-pphh and phhh-pphh interactions and on a tricky way of handling pre-summed sub-matrices, which enables one to decrease the number of {$\sim$}N 7 operations by converting them to {$\sim$}N 6. After a complete reorganization of the memory usage and handling of files, typical speedup factors of 1.6--1.8 are achieved for real calculations. Parallelization is straightforward with minimal communication requirements and scalability is excellent on distributed clusters.},
  date-added = {2015-08-21T21:12:04GMT},
  date-modified = {2020-01-05T01:10:46GMT},
  langid = {english},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2005/Noga/Molecular\%20Physics\%202005\%20Noga.pdf},
