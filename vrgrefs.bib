@article{VRG:morse:2017:SA,
  title = {A Photonic Platform for Donor Spin Qubits in Silicon},
  author = {Morse, Kevin J and Abraham, Rohan J S and DeAbreu, Adam and Bowness, Camille and Richards, Timothy S and Riemann, Helge and Abrosimov, Nikolay V and Becker, Peter and Pohl, Hans-Joachim and Thewalt, Michael L W and Simmons, Stephanie},
  year = {2017},
  month = jul,
  journal = {Sci. Adv.},
  volume = {3},
  number = {7},
  pages = {e1700930},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1007/BF00753562},
  url = {http://advances.sciencemag.org/lookup/doi/10.1126/sciadv.1700930},
  abstract = {Donor spins in silicon are highly competitive qubits for upcoming quantum technologies, offering complementary metal-oxide semiconductor compatibility, coherence ( T 2) times of minutes to hours, and simultaneous initialization, manipulation, and readout fidelities near  99.9\%. This allows for many quantum error correction protocols, which will be essential for scale-up. However, a proven method of reliably coupling spatially separated donor qubits has yet to be identified. We present a scalable silicon-based platform using the unique optical properties of ``deep'' chalcogen donors. For the prototypical 77Se+ donor, we measure lower bounds on the transition dipole moment and excited-state lifetime, enabling access to the strong coupling limit of cavity quantum electrodynamics using known silicon photonic resonator technology and integrated silicon photonics. We also report relatively strong photon emission from this same transition. These results unlock clear pathways for silicon-based quantum computing, spin-to-photon conversion, photonic memories, integrated single-photon sources, and all-optical switches.},
  date-added = {2019-04-30T13:52:24GMT},
  date-modified = {2019-12-29T22:17:18GMT},
  langid = {english},
  local-url = {file://localhost/Users/efv/odrive/gdrive-w/Work/Library/Papers2/Articles/2017/Morse/Sci.\%20Adv.\%202017\%20Morse.pdf},
  rating = {0},
